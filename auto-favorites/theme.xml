<theme>

  <formatVersion>7</formatVersion>
  <include>./../theme.xml</include>

  <view name="system">

    <text name="sys_top" extra="true">
      <text>Games</text>
    </text>
    <text name="sys_bottom" extra="true">
      <text>Favorites</text>
    </text>

    <text name="description" extra="true">
      <text>All your favorite games in one menu, add them to this list for quick access to all your favorite games.</text>
    </text>
    
  </view>
  
  <view name="grid">
    <text name="sys_full" extra="true">
      <text>Favorites</text>
    </text>
  </view>

</theme>