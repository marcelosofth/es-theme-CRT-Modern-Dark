<?xml version="1.0" encoding="utf-8"?>

<theme>
  <formatVersion>7</formatVersion>
  <customView name="detailed" inherits="grid">

    <image name="background" extra="true">
      <pos>0 0</pos>
      <origin>0 0</origin>
      <size>1 1</size>
      <path>./../_assets/background/ingame-global-bg.jpg</path>
      <zIndex>1</zIndex>
    </image>

    <!--Line image Grid-->
    <image name="line" extra="true">
      <origin>0 0</origin>
      <pos>0.456 0.020</pos>
      <size>0.0033 0.043</size>
      <path>./../_assets/dot.png</path>
      <color>c83131</color>
    </image>
    
    <text name="sys_full">
      <fontPath>./../_assets/fonts/BebasNeue.otf</fontPath>
      <alignment>left</alignment>
      <backgroundColor>00000000</backgroundColor>
      <forceUppercase>1</forceUppercase>
      <pos>0.468 0.020</pos>
      <size>0.3 0.04</size>
      <fontSize>0.049</fontSize>
      <color>818181</color>
    </text>

      <image name="logo">
        <linearSmooth>true</linearSmooth>
        <!--Lägger in en tom bild för att kunna se bättre just nu-->
        <path>./../_assets/logos2/default.svg</path>
        <path>./../_assets/logos2/${system.theme}.svg</path>
        <pos>0.9450 0.845</pos>
        <size>0.07 0.061</size>
        <color>1c1b1b</color>
        <zIndex>5</zIndex>
      </image>

     <image name="player_controller" extra="true">
      <origin>0 0</origin>
      <pos>0.456 0.125</pos>
      <maxSize>0.02943 0.022</maxSize>
      <linearSmooth>true</linearSmooth>
      <path>./../_assets/icons/players.svg</path>
      <color>FFFFFF</color>
    </image>

    <text name="md_players">
      <fontPath>./../_assets/fonts/Acre.otf</fontPath>
      <alignment>left</alignment>
      <backgroundColor>00000000</backgroundColor>
      <forceUppercase>false</forceUppercase>
      <pos>0.485 0.125</pos>
      <size>0.03 0.02</size>
      <fontSize>0.019</fontSize>
      <color>ffffff</color>
    </text>

    <rating name="md_rating">
      <pos>0.58277 0.12</pos>
      <size>1 0.026</size>
      <unfilledPath>./../_assets/icons/rating.png</unfilledPath>
      <filledPath>./../_assets/icons/rating-white.png</filledPath>
    </rating>

    <text name="md_genre">
      <fontPath>./../_assets/fonts/Acre.otf</fontPath>
      <alignment>left</alignment>
      <backgroundColor>00000000</backgroundColor>
      <forceUppercase>false</forceUppercase>
      <pos>0.71525 0.126</pos>
      <size>0.2 0.02</size>
      <fontSize>0.019</fontSize>
      <color>818181</color>
    </text>

    <text name="md_description">
      <fontPath>./../_assets/fonts/Acre.otf</fontPath>
      <color>818181</color>
      <fontSize>0.02</fontSize>
      <alignment>left</alignment>
      <forceUppercase>0</forceUppercase>
      <lineSpacing>1.2</lineSpacing>
      <pos>0.456 0.24</pos>
      <size>0.430 0.1801</size>
    </text>

    <!--Bytt Till Video-->
    <video name="md_video">
      <origin>0 0</origin>
      <pos>0.51135 0.4626</pos> 
      <maxSize>0.325 0.425</maxSize>
      <delay>0</delay>
      <showSnapshotNoVideo>true</showSnapshotNoVideo>
      <showSnapshotDelay>false</showSnapshotDelay>
    </video>

    <image name="md_favorite">
      <origin>0 0</origin>
      <pos>0.51635 0.44907</pos>
      <maxSize>1 0.035</maxSize>
      <linearSmooth>true</linearSmooth>
      <path>./../_assets/icons/star_filled.svg</path>
      <color>FFFFFFFF</color>
    </image>

    <image name="release_date_logo" extra="true">
      <pos>0.57335 0.172</pos>
      <maxSize>0.035</maxSize>
      <path>./../_assets/icons/game_info_releasedate.svg</path>
      <color>FFFFFFFF</color>
    </image>
    <datetime name="md_releasedate">
      <pos>0.602900 0.166</pos>
      <fontPath>./../_assets/fonts/Acre.otf</fontPath>
      <fontSize>0.024</fontSize>
      <color>818181</color>
    </datetime>

    <image name="developer_logo" extra="true">
      <pos>0.71395 0.172</pos>
      <maxSize>0.035</maxSize>
      <path>./../_assets/icons/game_info_publisher.svg</path>
      <color>FFFFFFFF</color>
    </image>
    <text name="md_developer">
      <pos>0.74195 0.179</pos>
      <fontPath>./../_assets/fonts/Acre.otf</fontPath>
      <fontSize>0.024</fontSize>
      <size>0.20 0.024</size>
      <color>818181</color>
    </text>

    <imagegrid name="gamegrid">
      <pos>0.435 0.05555</pos>
      <size>0.565 0.8657</size>
      <margin>0.026562 0.009 0 0</margin>
      <padding>0.01 0 0 0</padding>
      <imageSource>image</imageSource>
      <showVideoAtDelay>54888888</showVideoAtDelay>
      <animateSelection>false</animateSelection>
      <centerSelection>false</centerSelection>
      <scrollbarColor>818181FF</scrollbarColor>
      <scrollbarCorner>0.49</scrollbarCorner>
      <scrollbarSize>0.0065</scrollbarSize>
      <backgroundColor>FF55FF55</backgroundColor>
    </imagegrid>

    <!--Icon Lines-->
    <image name="playerLine" extra="true">
      <origin>0 0</origin>
      <pos>0.54405 0.125</pos>
      <size>0.0005 0.0212</size>
      <path>./../_assets/dot.png</path>
      <color>818181</color>
    </image>

    <image name="GenreLine" extra="true">
      <origin>0 0</origin>
      <pos>0.68656 0.125</pos>
      <size>0.0005 0.0212</size>
      <path>./../_assets/dot.png</path>
      <color>818181</color>
    </image>
    
    <image name="favLine" extra="true">
      <origin>0 0</origin>
      <pos>0.68656 0.182</pos>
      <size>0.0005 0.0212</size>
      <path>./../_assets/dot.png</path>
      <color>818181</color>
    </image>

    <image name="iniciarbtn" extra="true">
      <origin>0 0</origin>
      <pos>0.456 0.165</pos>
      <size>0.089061 0.05555</size>
      <path>./../_assets/icons/iniciar.svg</path>
      <color>FFFFFFFF</color>
    </image>

    <image name="gamelistButtons" extra="true">
      <linearSmooth>true</linearSmooth>
      <origin>0 0</origin>
      <pos>0.462 0.95740</pos>
      <size>0.34270 0.016</size>
      <path>./../_assets/icons/buttons-gamelist.svg</path>
      <color>FFFFFF</color>
    </image>


    <!--Line image Grid-->
    <image name="line2" extra="true">
      <origin>0 0</origin>
      <pos>0.030 0.020</pos>
      <size>0.0033 0.043</size>
      <path>./../_assets/dot.png</path>
      <color>c83131</color>
    </image>

    <textlist name="gamelist">
        <selectorColor>1c1c1c</selectorColor>
        <selectedColor>F8F8F8</selectedColor>
        <selectorHeight>0.05</selectorHeight>
        <primaryColor>585858</primaryColor>
        <secondaryColor>888888</secondaryColor>
        <fontPath>./../_assets/fonts/Acre.otf</fontPath>
        <alignment>left</alignment>
        <pos>0 0.0833</pos>
	    <size>0.400 0.8513</size>
        <fontSize>0.03</fontSize>
        <lineSpacing>1.483</lineSpacing>
        <horizontalMargin>0.02864</horizontalMargin>
        <scrollSound>./../_assets/cursor.wav</scrollSound>
    </textlist>
    
    <text name="top_label" extra="true">
      <fontPath>./../_assets/fonts/BebasNeue.otf</fontPath>
        <text>SELECT GAME</text>
        <alignment>left</alignment>
        <color>F8F8F8</color>
        <fontSize>0.049</fontSize>
        <origin>0 0</origin>
        <pos>0.046 0.003</pos>
        <size>0.20 0.08</size>
    </text>

  </customView>
</theme>