<?xml version="1.0" encoding="utf-8"?>

<theme>
  <feature supported="carousel">
    <view name="system">

      <image name="background" extra="true">
        <origin>1 0</origin>
        <pos>1 0</pos>
        <size>0 1</size>
        <path>./../_assets/background/background.png</path>
        <zIndex>0</zIndex>
        </image>

	<storyboard>
	<animation property="pos" to="0.22 0.5" begin="2000" duration="1000" mode="linear"/>
	</storyboard>
	<video name="videocrton" extra="false">
	<path>./../../_inc/anim/video/CRT_ON.mp4</path>
	<delay>0</delay>
	<loops>0</loops>
	<effect>none</effect>
	<origin>0.5 0.5</origin>
	<pos>0.5 0.39</pos>
	<maxSize>0.242</maxSize>
	<zIndex>26</zIndex>
	</video>
	<video name="videobox" extra="true">
	<path>{random}</path>
	<path>./../_assets/videos/${system.theme}.mp4</path>
	<default>./../_assets/videos/CRT_Noise.mp4</default>
	<delay>0</delay>
	<effect>none</effect>
	<origin>0.5 0.5</origin>
	<pos>0.718 0.414</pos>
        <size>0.318 0.424</size>
	<maxSize>0.424</maxSize>
	<zIndex>25</zIndex>
	<storyboard>
	</storyboard>
	</video>
	<text name="TextDate" extra="false">
	<pos>0.49 0.2</pos>
	<text>1990</text>
	<fontPath>./../../_inc/fonts/ubuntu_condensed.ttf</fontPath>
	<color>666666</color>
	<fontSize>0.025</fontSize>
	<zIndex>140</zIndex>
	</text>

    <image name="tv" extra="true">
      <origin>0 0</origin>
