        <logoScale>1</logoScale>
        <logoSize>0.125 0.0555555</logoSize>
        <color>FFFFFF00</color>
        <maxLogoCount>11</maxLogoCount>
        <zIndex>3</zIndex>
        <scrollSound>./../_assets/slide.wav</scrollSound>
      </carousel>
        
      <image name="logo">
        <linearSmooth>true</linearSmooth>
        <!--Lägger in en tom bild för att kunna se bättre just nu-->
        <path>./../_assets/logos/default.svg</path>
        <path>./../_assets/logos/${system.theme}.svg</path>
        <zIndex>5</zIndex>
      </image>
      
      <text name="logoText">
