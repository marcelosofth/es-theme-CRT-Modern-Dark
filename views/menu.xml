<?xml version="1.0" encoding="utf-8"?>

<theme>
  <formatVersion>7</formatVersion>
  <view name="menu">
    <menuText name="menutitle">
      <fontPath>./../_assets/fonts/Acre.otf</fontPath>
      <fontSize>0.044</fontSize>
      <color>cac8c9</color>
    </menuText>
    <menuText name="menufooter">
      <fontPath>./../_assets/fonts/Acre.otf</fontPath>
      <fontSize>0.02</fontSize>
      <color>302e2f</color>
    </menuText>
    
    <menuText name="menutext">
      <fontPath>./../_assets/fonts/Acre.otf</fontPath>
      <fontSize>0.031</fontSize>
      <color>c8c7c7</color>
      <separatorColor>343434</separatorColor>
      <selectorColor>c8c7c7</selectorColor>
      <selectorColorEnd>c8c7c7</selectorColorEnd>
      <selectedColor>121011</selectedColor>
      <selectorGradientType>horizontal</selectorGradientType>
    </menuText>

    <!--Making the scraper text the same-->
