<theme>

  <formatVersion>7</formatVersion>
  <include>./../theme.xml</include>

  <view name="system">

    <text name="sys_top" extra="true">
      <text>ASCII/Microsoft</text>
    </text>
    <text name="sys_bottom" extra="true">
      <text>MSX</text>
    </text>

    <text name="description" extra="true">
      <text>MSX is a standardized home computer architecture, conceived as an attempt to create unified standards among various hardware makers.</text>
    </text>
    
  </view>
  
  <view name="grid">
    <text name="sys_full" extra="true">
      <text>MSX</text>
    </text>
  </view>

</theme>